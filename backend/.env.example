# Samadhaan backend configuration
#
#   cp backend/.env.example backend/.env     then fill in the blanks
#
# backend/.env is gitignored. Never commit it, never paste these values into
# the repo, a Sarvam tool config, or a chat window.

# ---------------------------------------------------------------- database
# Supabase -> Project Settings -> Database -> Connection string -> URI
#
# Prefer the SESSION POOLER string (port 5432, host aws-N-<region>.pooler.
# supabase.com). The "direct connection" host db.<ref>.supabase.co is
# IPv6-only on new projects, so it fails on IPv4-only networks. Session
# pooler is IPv4-safe and fine for a long-lived server like ours.
#
# Do NOT use the transaction pooler on 6543 unless you have to: it disables
# prepared statements, which psycopg uses by default.
#
# Replace [YOUR-PASSWORD] with the database password you set when creating
# the project. If you did not note it: Project Settings -> Database ->
# Reset database password.
# Append ?sslmode=require. Without it libpq defaults to "prefer", which
# silently falls back to PLAINTEXT if TLS is not offered - merchant PII and
# this password crossing the internet unencrypted. Measured: no latency cost.
# sslmode=verify-full is better still, but needs the project CA certificate
# from Supabase -> Project Settings -> Database -> SSL Configuration, then
# add &sslrootcert=<path to the .crt>.
DATABASE_URL=

# ------------------------------------------------------------ supabase api
# Supabase -> Project Settings -> API -> Project URL
# Looks like https://abcdefghijklm.supabase.co
SUPABASE_URL=

# Supabase -> Project Settings -> API Keys
#
# Newer projects show:   sb_secret_...        <- use this one
# Older projects show:   service_role  (a long JWT starting eyJ...)
#
# This key BYPASSES row level security. It is the only thing that can read or
# write our tables, because RLS is enabled with no policies. Server-side only.
# It must never appear in a browser bundle, the repo, or a Sarvam tool header.
SUPABASE_SERVICE_ROLE_KEY=

# The anon / publishable key is deliberately NOT needed. The dashboard reads
# Supabase server-side with the service role, so no key reaches the browser.

# ----------------------------------------------------------- shared secret
# Sent by Sarvam on every tool call as the header:  X-Samadhan-Key
# Rahul sets this same value in the Sarvam tool config, as a masked secret.
# This one is pre-generated; keep it or replace it, but both sides must match.
SAMADHAN_API_KEY=NGyZLeXdFOd3569AgzvclPOCBy4pUiBECiIhH1DwAdg

# ------------------------------------------------------------------ tuning
# How recently a case must have been touched to be resumed on a callback.
CASE_RESUME_WINDOW_DAYS=7

# Working days ahead to schedule a Soundbox pickup / technician visit.
PICKUP_SLA_DAYS=4
TECHNICIAN_SLA_DAYS=3

# Set to 1 to log every tool call's request and response to stdout. Useful for
# debugging a live call; noisy otherwise.
SAMADHAN_DEBUG=1

# ------------------------------------------------------- operator credential
# Separate key for /ops/* and /admin/* — approving refunds, resetting demo
# data, binding phone numbers. The voice-agent key must NOT authorise these:
# it lives in a third-party platform's tool config.
# If left empty, those paths fall back to SAMADHAN_API_KEY and the app logs a
# warning at startup. The dashboard reads this one.
OPERATOR_API_KEY=

# /admin/reset wipes and reseeds the database, and /admin/bind-phone points a
# live number at a seeded persona. Both are refused unless this is on.
DEMO_MODE=1
